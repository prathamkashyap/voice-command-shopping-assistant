rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only access their own shopping list data
    match /users/{userId}/shoppingList/items/{itemId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Users can only access their own history
    match /users/{userId}/history/{historyId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Users can only access their own meta
    match /users/{userId}/shoppingList/meta {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}